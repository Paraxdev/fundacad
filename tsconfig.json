{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // vue-tsc requires a jsx setting even though this project has no JSX.
    "jsx": "preserve"
  },
  // No `declare module "*.vue"` shim, deliberately: it would win over vue-tsc's
  // real resolution and silently switch off prop type-checking.
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
